CHANNEL_ACCESS_TOKEN=your_line_access_token
CHANNEL_SECRET=your_line_secret
PORT=5782
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=30

# Host URL for auth callback (e.g. https://your-domain.com)
HOST_URL=http://localhost:5782

# Encryption key for user API keys (32 bytes hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_encryption_key
